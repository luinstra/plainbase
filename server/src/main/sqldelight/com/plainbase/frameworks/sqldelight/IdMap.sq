-- Identity persistence (chunk 4b; composite (root, path) keys since multi-root C2, ADR-0011):
-- id_map ((root, path) -> id binding + materialization state), identity_issue (the admin issues
-- list), url_alias (old canonical URL path -> page id, per root).
--
-- ID storage policy (master plan decision log #6): binary at rest, text at the boundary.
-- Every id column is BLOB NOT NULL holding the UUID's 16 raw bytes, msb||lsb big-endian;
-- the conversion lives in exactly one place — PageIdColumnAdapter. Operator note: ad-hoc
-- inspection uses hex(id) / x'…' literals in the sqlite3 CLI (known, accepted cost).
-- root columns hold the validated RootName slug (ADR-0011 D14: TEXT names, human-inspectable
-- alongside hex(id); 'main' is reserved so migration stamps are safe forever).

import com.plainbase.domain.content.TreePath;
import com.plainbase.domain.page.PageId;
import com.plainbase.domain.root.RootName;
import kotlin.Boolean;

-- One binding per (root, path) AND per (id, root) (per-root identity, C5): the same page id may live in SEVERAL
-- roots at once, and within a root the §5.2 duplicate policy plus bind()'s root-scoped stale sweep keep an id bound
-- to at most one (root, path). So UNIQUE(id, root) - NOT UNIQUE(id) - is the invariant the schema enforces. The
-- constraint is id-LEADING so its one autoindex serves both the bare resolver's WHERE id = ? and the root-scoped
-- incumbent's WHERE id = ? AND root = ? as index SEARCHes (proved by IdMapIndexUsageTest).
CREATE TABLE id_map (
  root TEXT AS RootName NOT NULL,
  path TEXT AS TreePath NOT NULL,
  id BLOB AS PageId NOT NULL,
  materialized INTEGER AS Boolean NOT NULL,
  PRIMARY KEY (root, path),
  UNIQUE (id, root)
);

-- A flattened IdentityIssue: kind discriminates the sealed variant; the remaining columns carry
-- whichever context that variant defines (the per-kind mapping is documented in ONE place —
-- SqlDelightIdMapRepository.IssueRow). The natural key is (kind, root, path, other_root,
-- other_path, page_id) and the UNIQUE constraint makes record() idempotence schema-enforced, not
-- application-level. Variants without a second root/path or an id store sentinels ('' /
-- zero-length BLOB) instead of NULL: SQLite treats NULLs as DISTINCT inside a UNIQUE index, which
-- would silently defeat the dedup. Since C7 removed the one cross-root kind (ADR-0012), other_root
-- is ALWAYS the sentinel: every surviving kind is a within-root fact and keeps its second path under
-- the row's own root. The column stays because it is part of the UNIQUE key above.
CREATE TABLE identity_issue (
  kind TEXT NOT NULL,
  root TEXT AS RootName NOT NULL,
  path TEXT AS TreePath NOT NULL,
  other_root TEXT NOT NULL,
  other_path TEXT NOT NULL,
  page_id BLOB NOT NULL,
  message TEXT,
  UNIQUE(kind, root, path, other_root, other_path, page_id)
);

-- TOMBSTONES (C0). A binding that leaves id_map lands here, and its id is RESERVED within its root (the PK is
-- (root, id), per-root identity C5): /p/{root}/{id} answers 410 Gone naming the last-known path instead of the
-- 404 that tells an agent to drop its citation. IdMapRepository.kt:14 says why this table has to exist at all - "durability is only
-- promised for materialized ids" - so for an UNMATERIALIZED page the id_map row is the SOLE record a
-- path ever had that id: hard-delete it and the page returns with a fresh id, permalink gone forever.
--
-- It is a SEPARATE TABLE, not a `retired_at` flag on id_map, and that is the whole point: tombstones
-- live OUTSIDE the live (root, path) key space, so ordinary path reuse (delete a page; later create a
-- DIFFERENT page at the same path) cannot collide with one and there is no collision to arbitrate.
-- `path` is the LAST-KNOWN path and is deliberately NOT a key - reuse is legal. `id` is the key,
-- because the id is what the tombstone is about.
--
-- The reservation is PER ROOT (the PK is (root, id), and id_map is UNIQUE(id, root)): a tombstone under root R
-- reserves id X for R's own page only, and a retired (R, X) may be reclaimed ONLY by the same page returning to its
-- OWN (root, path) under R; anyone else mints fresh. No SQL UNIQUE can span the live and retired tables, so that
-- cross-table reservation is enforced INSIDE the bind transaction - SqlDelightIdMapRepository.bind - never by
-- convention. Two roots may each hold a tombstone for one id at once (a legal per-root retirement).
--
-- No GC. A row per page that ever existed is nothing, and a retention horizon is just soft-retirement
-- becoming hard on a timer - i.e. the permalink-destroyer this table exists to prevent.
CREATE TABLE retired_binding (
  id BLOB AS PageId NOT NULL,
  root TEXT AS RootName NOT NULL,
  path TEXT AS TreePath NOT NULL,
  materialized INTEGER AS Boolean NOT NULL,
  retired_at INTEGER NOT NULL,
  PRIMARY KEY (root, id)
);

-- The PK is (root, id), so a bare `WHERE id = ?` was an UNINDEXED SCAN - and the retired-root resolution fires on
-- EVERY live None (every unknown-id bare permalink), so a `/p/{random-uuid}` scanner flood paid O(tombstones). This
-- index serves selectRetiredRootsHoldingId; it is additive (table/PK/columns untouched).
CREATE INDEX retired_binding_id ON retired_binding(id);

-- An old canonical URL path -> the page's rooted id (§A4), keyed per root: URL space is per-root, so
-- the same old path may alias different pages under different roots. The value is always a PAGE
-- (target_root, id), never another alias, so chains collapse by construction (one hop). target_root
-- names the root that holds the target page, so a resolved alias yields a (root, id) rather than a
-- bare id (an alias may target a page in a DIFFERENT root than the one whose URL space it lives in).
-- Rows are written by chunk 5's IndexBuilder (move detection) and redirect_from registration.
-- Documented derived-state exception: NOT rebuildable from the tree alone — losing DATA_DIR loses
-- old-URL continuity.
CREATE TABLE url_alias (
  root TEXT AS RootName NOT NULL,
  path TEXT AS TreePath NOT NULL,
  id BLOB AS PageId NOT NULL,
  target_root TEXT AS RootName NOT NULL DEFAULT 'main',
  PRIMARY KEY (root, path)
);

selectBinding:
SELECT *
FROM id_map
WHERE root = :root AND path = :path;

-- The bare-id resolver's LIVE claimant list (Option B). Index-served by the id-leading UNIQUE(id, root). Shaped
-- List<RootName> for the C5 multiplicity the One/Ambiguous/None contract models - post-flip it is 0..N rows, one
-- per root holding the id live.
selectRootsHoldingId:
SELECT root
FROM id_map
WHERE id = :id;

-- The retired-claimant list, index-served by retired_binding_id. No longer on the production hot path (the resolver
-- reads selectClaimantsById via claimantState); KEPT as the list twin of selectRootsHoldingId, pinned by
-- IdMapClaimantQueriesNativeTest and the resolver fakes.
selectRetiredRootsHoldingId:
SELECT root
FROM retired_binding
WHERE id = :id;

-- One tombstone by its full (root, id) key - the resolved retirement's last-known path (index-served by the
-- root-leading PK).
selectRetiredAt:
SELECT *
FROM retired_binding
WHERE root = :root AND id = :id;

selectAllBindings:
SELECT *
FROM id_map;

selectDistinctRoots:
SELECT DISTINCT root
FROM id_map;

deleteBinding:
DELETE FROM id_map
WHERE root = :root AND path = :path;

-- Tombstone reads/writes. `retire` is an upsert so a re-retirement of the same id (an idempotent
-- replay) refreshes the last-known path rather than failing on the primary key.
selectAllRetired:
SELECT *
FROM retired_binding;

retire:
INSERT INTO retired_binding(id, root, path, materialized, retired_at)
VALUES (:id, :root, :path, :materialized, :retiredAt)
ON CONFLICT(root, id) DO UPDATE SET path = excluded.path, materialized = excluded.materialized;

upsertBinding:
INSERT INTO id_map(root, path, id, materialized)
VALUES (:root, :path, :id, :materialized)
ON CONFLICT(root, path) DO UPDATE SET id = excluded.id, materialized = excluded.materialized;

markMaterialized:
UPDATE id_map
SET materialized = :materialized
WHERE root = :root AND path = :path;

-- Upsert against the UNIQUE natural key (no read-then-insert window): re-recording an issue
-- never grows the list, but DOES refresh message — a refusal whose reason changed between
-- adopt runs must surface the current guidance, not the first one recorded. The WHERE guard
-- keeps the byte-identical re-record a true no-op (no row rewrite).
insertIssue:
INSERT INTO identity_issue(kind, root, path, other_root, other_path, page_id, message)
VALUES (:kind, :root, :path, :otherRoot, :otherPath, :pageId, :message)
ON CONFLICT(kind, root, path, other_root, other_path, page_id)
DO UPDATE SET message = excluded.message WHERE message IS NOT excluded.message;

selectAllIssues:
SELECT *
FROM identity_issue;

-- The DO UPDATE arm must re-set target_root alongside id: re-pointing an existing alias path to a
-- different page (possibly in a different root) has to carry the new target's root, or the row keeps
-- the STALE target_root and the alias resolves to the wrong root.
upsertAlias:
INSERT INTO url_alias(root, path, id, target_root)
VALUES (:root, :path, :id, :targetRoot)
ON CONFLICT(root, path) DO UPDATE SET id = excluded.id, target_root = excluded.target_root;

selectAliasTarget:
SELECT target_root, id
FROM url_alias
WHERE root = :root AND path = :path;

-- C5: the ROOT-SCOPED incumbent read - every id lookup is root-qualified now (the bare-id form is gone). Index-served
-- by UNIQUE(id, root), which is id-LEADING so the one index covers both WHERE id = ? and WHERE id = ? AND root = ?.
selectBindingByRootId:
SELECT *
FROM id_map
WHERE id = :id AND root = :root;

-- C5: the ROOT-SCOPED stale sweep. The global unbindStale deletes ANOTHER root's LIVE row for the same id with NO
-- tombstone minted, so the untouched file mints a fresh id on the next pass and its permalink breaks silently. Added
-- UNUSED in Commit A.
unbindStaleInRoot:
DELETE FROM id_map
WHERE id = :id AND root = :root AND path != :path;

-- C5: the ROOT-SCOPED un-retirement. The global unretire deletes BOTH roots' tombstones, so /p/{otherRoot}/{id}
-- flips from a truthful 410 to a false 404. Added UNUSED in Commit A.
unretireInRoot:
DELETE FROM retired_binding
WHERE root = :root AND id = :id;

-- C5: EVERY tombstone row for an id (0..N once two roots may each hold one). Index-served by retired_binding_id.
-- LIST-shaped on purpose: a single-row `executeAsOneOrNull` by id would throw the moment a second root tombstones it.
-- The resolver's claimant state is served by selectClaimantsById (both lists, one snapshot); this is the standalone
-- retired-rows twin. Added UNUSED in Commit A.
selectRetiredRowsById:
SELECT *
FROM retired_binding
WHERE id = :id;

-- C5: BOTH claimant lists for an id in ONE statement, so claimantState reads them WITHOUT a transaction. The app DB is
-- one shared non-thread-safe JdbcSqliteDriver (a statement per read), and a BEGIN on that connection races a concurrent
-- bare resolve's BEGIN into "cannot start a transaction within a transaction". A single SQLite SELECT is already a
-- consistent cross-table snapshot, so this keeps the torn-read atomicity the wrapping transaction gave WITHOUT the
-- BEGIN. The typed retired_binding SELECT leads so the shared columns inherit its path/id/materialized/retired_at
-- adapters; the live SELECT carries NULLs there. kind: 1 = a retired tombstone (its columns non-null), 0 = a live
-- claimant (root only). Index-served both sides (retired_binding_id; the id-leading UNIQUE(id, root)).
selectClaimantsById:
SELECT 1 AS kind, root, path, id, materialized, retired_at
FROM retired_binding
WHERE id = :id
UNION ALL
SELECT 0 AS kind, root, NULL, NULL, NULL, NULL
FROM id_map
WHERE id = :id;

selectAllAliases:
SELECT *
FROM url_alias;

deleteAlias:
DELETE FROM url_alias
WHERE root = :root AND path = :path;
