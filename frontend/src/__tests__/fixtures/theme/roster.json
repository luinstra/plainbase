      "default": "\"IBM Plex Sans\", ui-sans-serif, system-ui, sans-serif",
      "generic": [
        "--pb-font-sans"
      ],
      "builtin-light": [
        "--pb-font-sans"
      ],
      "builtin-dark": [
        "--pb-font-sans"
      ],
      "adaptation": "Uses the current app.css sans-serif stack; built-ins inherit the private role from generic.",
