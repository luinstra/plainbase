{
  "description": "Unreleased --pb-theme-* CSS inputs, separate from the pb-theme localStorage display-mode key. Floors are minimum consumers; dependency closure may move more.",
  "inputs": {
    "--pb-theme-background": {
      "required": true,
      "kind": "colour",
      "default": null,
      "generic": [
        "--pb-surface"
      ],
      "builtin-light": [
        "--pb-surface"
      ],
      "builtin-dark": [
        "--pb-surface"
      ],
      "adaptation": "Base document surface; mode-specific translucent scrim and shadow also depend on it.",
      "tinted-base16": "base00",
      "tinted-base24": "base00"
    },
    "--pb-theme-foreground": {
      "required": true,
      "kind": "colour",
      "default": null,
      "generic": [
        "--pb-text"
      ],
      "builtin-light": [
        "--pb-text"
      ],
      "builtin-dark": [
        "--pb-text"
      ],
      "adaptation": "Base document ink; mixed faint ink and links also depend on it.",
      "tinted-base16": "base05",
      "tinted-base24": "base05"
    },
    "--pb-theme-primary": {
      "required": true,
      "kind": "colour",
      "default": null,
      "generic": [
        "--pb-primary-bg",
        "--pb-primary-border",
        "--pb-primary-opaque",
        "--pb-accent",
        "--pb-discussion-highlight-edge"
      ],
      "builtin-light": [
        "--pb-primary-bg",
        "--pb-primary-border",
        "--pb-accent",
        "--pb-discussion-highlight-edge",
        "--pb-primary-opaque"
      ],
      "builtin-dark": [
        "--pb-primary-bg",
        "--pb-accent",
        "--pb-discussion-highlight-edge",
        "--pb-primary-opaque"
      ],
      "adaptation": "Action fill keeps input alpha; primary-opaque supplies opaque accent ink and callout mixtures.",
      "tinted-base16": "base0D",
      "tinted-base24": "base0D"
    },
    "--pb-theme-primary-foreground": {
      "required": true,
      "kind": "colour",
      "default": null,
      "generic": [
        "--pb-primary-text",
        "--pb-accent-contrast"
      ],
      "builtin-light": [
        "--pb-primary-text",
        "--pb-accent-contrast"
      ],
      "builtin-dark": [
        "--pb-primary-text"
      ],
      "adaptation": "Action ink; the dark built-in accent-contrast retains its current expression.",
      "tinted-base16": "base00",
      "tinted-base24": "base00"
    },
    "--pb-theme-card": {
      "required": false,
      "kind": "colour",
      "default": "color-mix(in srgb, var(--pb-theme-background), var(--pb-theme-foreground) 3%)",
      "generic": [
        "--pb-surface-raised",
        "--pb-surface-field",
        "--pb-code-bg",
        "--pb-diagram-node-bg"
      ],
      "builtin-light": [
        "--pb-surface-raised",
        "--pb-surface-field",
        "--pb-code-bg",
        "--pb-diagram-node-bg"
      ],
      "builtin-dark": [
        "--pb-surface-raised"
      ],
      "adaptation": "Raised surfaces; built-in refinements preserve distinct field, code and diagram surfaces where specified.",
      "tinted-base16": null,
      "tinted-base24": null
    },
    "--pb-theme-card-foreground": {
      "required": false,
      "kind": "colour",
      "default": "var(--pb-theme-foreground)",
      "generic": [
        "--pb-card-foreground",
        "--pb-diagram-node-text",
        "--pb-code-text"
      ],
      "builtin-light": [
        "--pb-card-foreground",
        "--pb-diagram-node-text"
      ],
      "builtin-dark": [
        "--pb-card-foreground",
        "--pb-diagram-node-text"
      ],
      "adaptation": "Generic code and diagram ink follows card-foreground; current built-in code-text remains refined.",
      "tinted-base16": null,
      "tinted-base24": null
    },
    "--pb-theme-muted": {
      "required": false,
      "kind": "colour",
      "default": "color-mix(in srgb, var(--pb-theme-background), var(--pb-theme-foreground) 6%)",
      "generic": [
        "--pb-surface-chrome",
        "--pb-inline-code-bg",
        "--pb-table-header-bg"
      ],
      "builtin-light": [
        "--pb-surface-chrome",
        "--pb-table-header-bg"
      ],
      "builtin-dark": [
        "--pb-surface-chrome"
      ],
      "adaptation": "Quiet surfaces; built-in inline-code-bg and the dark table-header-bg retain their current expressions.",
      "tinted-base16": "base01",
      "tinted-base24": "base01"
    },
    "--pb-theme-muted-foreground": {
      "required": false,
      "kind": "colour",
      "default": "color-mix(in srgb, var(--pb-theme-foreground), var(--pb-theme-background) 15%)",
      "generic": [
        "--pb-text-muted"
      ],
      "builtin-light": [
        "--pb-text-muted"
      ],
      "builtin-dark": [
        "--pb-text-muted"
      ],
      "adaptation": "Secondary ink and the default syntax-comment dependency.",
      "tinted-base16": "base04",
      "tinted-base24": "base04"
    },
    "--pb-theme-border": {
      "required": false,
      "kind": "colour",
      "default": "color-mix(in srgb, var(--pb-theme-foreground), var(--pb-theme-background) 75%)",
      "generic": [
        "--pb-border",
        "--pb-code-border"
      ],
      "builtin-light": [
        "--pb-border",
        "--pb-code-border"
      ],
      "builtin-dark": [
        "--pb-border",
        "--pb-code-border"
      ],
      "adaptation": "Edge colour; generic stronger edges mix in foreground ink.",
      "tinted-base16": null,
      "tinted-base24": null
    },
    "--pb-theme-ring": {
      "required": false,
      "kind": "colour",
      "default": "rgb(from var(--pb-theme-primary) r g b / 1)",
      "generic": [
        "--pb-focus-ring"
      ],
      "builtin-light": [
        "--pb-focus-ring"
      ],
      "builtin-dark": [
        "--pb-focus-ring"
      ],
      "adaptation": "Focus-outline colour; default uses opaque primary channels.",
      "tinted-base16": "base0D",
      "tinted-base24": "base16"
    },
    "--pb-theme-selection": {
      "required": false,
      "kind": "colour",
      "default": "color-mix(in srgb, var(--pb-theme-primary), var(--pb-theme-background) 88%)",
      "generic": [
        "--pb-selection-bg",
        "--pb-deeplink-pulse",
        "--pb-nav-active-bg",
        "--pb-discussion-highlight-bg"
      ],
      "builtin-light": [
        "--pb-selection-bg",
        "--pb-deeplink-pulse"
      ],
      "builtin-dark": [
        "--pb-selection-bg",
        "--pb-deeplink-pulse"
      ],
      "adaptation": "Selection highlight; built-in navigation and discussion refinements retain their current expressions.",
      "tinted-base16": "base02",
      "tinted-base24": "base02"
    },
    "--pb-theme-selection-foreground": {
      "required": false,
      "kind": "colour",
      "default": "var(--pb-theme-foreground)",
      "generic": [
        "--pb-selection-text"
      ],
      "builtin-light": [
        "--pb-selection-text"
      ],
      "builtin-dark": [
        "--pb-selection-text"
      ],
      "adaptation": "Selected text ink.",
      "tinted-base16": "base05",
      "tinted-base24": "base05"
    },
    "--pb-theme-destructive": {
      "required": false,
      "kind": "colour",
      "default": "var(--pb-theme-foreground)",
      "generic": [
        "--pb-danger",
        "--pb-status-deprecated"
      ],
      "builtin-light": [
        "--pb-danger",
        "--pb-status-deprecated"
      ],
      "builtin-dark": [
        "--pb-danger"
      ],
      "adaptation": "Destructive ink; generic feedback and diff tints are in its dependency closure.",
      "tinted-base16": "base08",
      "tinted-base24": "base12"
    },
    "--pb-theme-warning": {
      "required": false,
      "kind": "colour",
      "default": "var(--pb-theme-foreground)",
      "generic": [
        "--pb-warning",
        "--pb-link-broken",
        "--pb-status-draft"
      ],
      "builtin-light": [
        "--pb-warning",
        "--pb-link-broken",
        "--pb-status-draft"
      ],
      "builtin-dark": [
        "--pb-warning",
        "--pb-link-broken"
      ],
      "adaptation": "Warning ink; the light built-in syntax-literal dependency belongs to its public syntax definition.",
      "tinted-base16": "base0A",
      "tinted-base24": "base13"
    },
    "--pb-theme-success": {
      "required": false,
      "kind": "colour",
      "default": "var(--pb-theme-foreground)",
      "generic": [
        "--pb-status-active"
      ],
      "builtin-light": [
        "--pb-status-active"
      ],
      "builtin-dark": [
        "--pb-status-active"
      ],
      "adaptation": "Successful-state ink; generic diff-add-bg is in its dependency closure.",
      "tinted-base16": "base0B",
      "tinted-base24": "base14"
    },
    "--pb-theme-syntax-keyword": {
      "required": false,
      "kind": "colour",
      "default": "var(--pb-theme-foreground)",
      "generic": [
        "--pb-syntax-keyword"
      ],
      "builtin-light": [
        "--pb-syntax-keyword"
      ],
      "builtin-dark": [
        "--pb-syntax-keyword"
      ],
      "adaptation": "Maps the public syntax-keyword input to --pb-syntax-keyword.",
      "tinted-base16": "base0E",
      "tinted-base24": "base17"
    },
    "--pb-theme-syntax-string": {
      "required": false,
      "kind": "colour",
      "default": "var(--pb-theme-foreground)",
      "generic": [
        "--pb-syntax-string"
      ],
      "builtin-light": [
        "--pb-syntax-string"
      ],
      "builtin-dark": [
        "--pb-syntax-string"
      ],
      "adaptation": "Maps the public syntax-string input to --pb-syntax-string.",
      "tinted-base16": "base0B",
      "tinted-base24": "base14"
    },
    "--pb-theme-syntax-comment": {
      "required": false,
      "kind": "colour",
      "default": "var(--pb-theme-muted-foreground)",
      "generic": [
        "--pb-syntax-comment"
      ],
      "builtin-light": [
        "--pb-syntax-comment"
      ],
      "builtin-dark": [
        "--pb-syntax-comment"
      ],
      "adaptation": "Maps the public syntax-comment input to --pb-syntax-comment.",
      "tinted-base16": "base04",
      "tinted-base24": "base04"
    },
    "--pb-theme-syntax-literal": {
      "required": false,
      "kind": "colour",
      "default": "var(--pb-theme-foreground)",
      "generic": [
        "--pb-syntax-literal"
      ],
      "builtin-light": [
        "--pb-syntax-literal"
      ],
      "builtin-dark": [
        "--pb-syntax-literal"
      ],
      "adaptation": "Maps the public syntax-literal input to --pb-syntax-literal.",
      "tinted-base16": "base09",
      "tinted-base24": "base09"
    },
    "--pb-theme-syntax-title": {
      "required": false,
      "kind": "colour",
      "default": "var(--pb-theme-foreground)",
      "generic": [
        "--pb-syntax-title"
      ],
      "builtin-light": [
        "--pb-syntax-title"
      ],
      "builtin-dark": [
        "--pb-syntax-title"
      ],
      "adaptation": "also colours hljs-name and hljs-selector-tag (app.css hljs title group)",
      "tinted-base16": "base0D",
      "tinted-base24": "base16"
    },
    "--pb-theme-syntax-attribute": {
      "required": false,
      "kind": "colour",
      "default": "var(--pb-theme-foreground)",
      "generic": [
        "--pb-syntax-attr"
      ],
      "builtin-light": [
        "--pb-syntax-attr"
      ],
      "builtin-dark": [
        "--pb-syntax-attr"
      ],
      "adaptation": "Maps the public syntax-attribute input to --pb-syntax-attr.",
      "tinted-base16": "base08",
      "tinted-base24": "base12"
    },
    "--pb-theme-font-sans": {
      "required": false,
